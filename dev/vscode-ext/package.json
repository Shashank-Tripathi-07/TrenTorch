{
  "name": "trentorch-workbench",
  "displayName": "TinyTorch Workbench",
  "description": "Build, test, and manage TinyTorch educational ML framework modules",
  "version": "0.1.0",
  "publisher": "mlsysbook",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "workspaceContains:trentorch/src/01_tensor"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "trentorch",
          "title": "TinyTorch",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "trentorch": [
        { "id": "trentorch.modules", "name": "Modules" },
        { "id": "trentorch.testing", "name": "Testing" },
        { "id": "trentorch.build", "name": "Build & Site" },
        { "id": "trentorch.runs", "name": "Recent Runs" },
        { "id": "trentorch.info", "name": "Info & Health" }
      ]
    },
    "commands": [
      { "command": "trentorch.openNotebook", "title": "TinyTorch: Open Notebook" },
      { "command": "trentorch.openSource", "title": "TinyTorch: Open Source (.py)" },
      { "command": "trentorch.startModule", "title": "TinyTorch: Start Module" },
      { "command": "trentorch.viewModule", "title": "TinyTorch: Open Module in Jupyter" },
      { "command": "trentorch.testModule", "title": "TinyTorch: Test Module" },
      { "command": "trentorch.completeModule", "title": "TinyTorch: Complete Module" },
      { "command": "trentorch.resetModule", "title": "TinyTorch: Reset Module" },
      { "command": "trentorch.openAbout", "title": "TinyTorch: Open Module ABOUT" },
      { "command": "trentorch.runAction", "title": "TinyTorch: Run Action" },
      { "command": "trentorch.runSiteAction", "title": "TinyTorch: Run Site Action" },
      { "command": "trentorch.runPaperAction", "title": "TinyTorch: Run Paper Action" },
      { "command": "trentorch.runTests", "title": "TinyTorch: Run Tests" },
      { "command": "trentorch.buildSite", "title": "TinyTorch: Build HTML Site" },
      { "command": "trentorch.buildPdf", "title": "TinyTorch: Build PDF Course Guide" },
      { "command": "trentorch.buildPaper", "title": "TinyTorch: Build Research Paper" },
      { "command": "trentorch.openSiteInBrowser", "title": "TinyTorch: Open Site in Browser" },
      { "command": "trentorch.openPdf", "title": "TinyTorch: Open PDF" },
      { "command": "trentorch.healthCheck", "title": "TinyTorch: Health Check" },
      { "command": "trentorch.refreshModules", "title": "TinyTorch: Refresh Modules", "icon": "$(refresh)" },
      { "command": "trentorch.refreshRuns", "title": "TinyTorch: Refresh Runs", "icon": "$(refresh)" },
      { "command": "trentorch.rerunLastCommand", "title": "TinyTorch: Rerun Last Command", "icon": "$(history)" },
      { "command": "trentorch.revealTerminal", "title": "TinyTorch: Reveal Terminal", "icon": "$(terminal)" },
      { "command": "trentorch.rerunCommand", "title": "TinyTorch: Rerun Command" }
    ],
    "configurationDefaults": {
      "workbench.tree.indent": 16
    },
    "menus": {
      "view/title": [
        { "command": "trentorch.refreshModules", "when": "view == trentorch.modules", "group": "navigation" },
        { "command": "trentorch.refreshRuns", "when": "view == trentorch.runs", "group": "navigation@1" },
        { "command": "trentorch.rerunLastCommand", "when": "view == trentorch.runs", "group": "navigation@2" },
        { "command": "trentorch.revealTerminal", "when": "view == trentorch.runs", "group": "navigation@3" }
      ]
    }
  }
}
